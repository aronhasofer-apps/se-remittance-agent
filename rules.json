{
  "version": "1.0.2",
  "updated": "2026-06-21",
  "rules": [
    {
      "id": "ariba-skip",
      "description": "Ariba network notifications - always skip",
      "match": {
        "subject_contains": [
          "Notice of new Remittance Advice",
          "AribaNetworkAdmin"
        ]
      },
      "action": "skip"
    },
    {
      "id": "ariba-scheduled-skip",
      "description": "Ariba scheduled payment notices - skip",
      "match": {
        "subject_contains": [
          "Notice of new scheduled payment"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bill-invoice-skip",
      "description": "BILL.com invoice received notifications - skip",
      "match": {
        "subject_contains": [
          "received your invoice"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bms-flag",
      "description": "BMS mismatch/RITM - flag for review",
      "match": {
        "subject_contains": [
          "MISMATCH",
          "RITM",
          "PO AND VENDOR NAME"
        ]
      },
      "action": "flag"
    },
    {
      "id": "gsk-attachment",
      "description": "GSK Payment Advice Note - save PDF attachment",
      "match": {
        "subject_contains": [
          "Payment Advice Note",
          "GlaxoSmithKline"
        ]
      },
      "action": "save_attachment",
      "short_name": "GSK",
      "notes": "Check currency - may be GBP."
    },
    {
      "id": "bms-attachment",
      "description": "Bristol Myers Squibb payment - save PDF attachment",
      "match": {
        "subject_contains": [
          "Bristol Myers Squibb",
          "Bristol-Myers",
          "BMS Payment"
        ]
      },
      "action": "save_attachment",
      "short_name": "BMS"
    },
    {
      "id": "ramp-delivered",
      "description": "Ramp payment delivered - extract from body",
      "match": {
        "subject_contains": [
          "Payment delivered for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject",
      "notes": "Payor after from in subject. Amount under Payment amount in body."
    },
    {
      "id": "ramp-received",
      "description": "Ramp payment received - extract from body",
      "match": {
        "subject_contains": [
          "Payment received:"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject"
    },
    {
      "id": "bill-delayed",
      "description": "BILL.com payment delayed/deposited - extract from body",
      "match": {
        "subject_contains": [
          "payment is delayed",
          "will be deposited today",
          "Your payment from"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_body",
      "notes": "Payor name is company name ABOVE initiated a payment of in body. Supports CN- and RI- invoice numbers."
    },
    {
      "id": "merck-body",
      "description": "Merck payment remittance - extract from body",
      "match": {
        "subject_contains": [
          "PAYMENT REMITTANCE DETAIL"
        ]
      },
      "action": "extract_body",
      "short_name": "Merck"
    },
    {
      "id": "gilead-attachment",
      "description": "Gilead Sciences remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "Gilead"
        ]
      },
      "action": "save_attachment",
      "short_name": "Gilead Sciences"
    },
    {
      "id": "takeda-attachment",
      "description": "Takeda direct PDF payment - save attachment",
      "match": {
        "subject_contains": [
          "Takeda",
          "SMB.vendor"
        ]
      },
      "action": "save_attachment",
      "short_name": "Takeda",
      "notes": "Takeda also sends via Ariba - those are caught by ariba-skip rule separately"
    },
    {
      "id": "vertex-attachment",
      "description": "Vertex Pharmaceuticals remittance - save attachment",
      "match": {
        "subject_contains": [
          "Vertex Remittance",
          "Vertex Pharmaceuticals"
        ]
      },
      "action": "save_attachment",
      "short_name": "Vertex",
      "notes": "May be HTML. AIS Operating Co is separate entity."
    },
    {
      "id": "abbvie-attachment",
      "description": "AbbVie remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "AbbVie"
        ]
      },
      "action": "save_attachment",
      "short_name": "AbbVie"
    },
    {
      "id": "terray-attachment",
      "description": "Terray Therapeutics - save PDF attachment",
      "match": {
        "subject_contains": [
          "Terray Therapeutics"
        ]
      },
      "action": "save_attachment",
      "short_name": "Terray Therapeutics"
    },
    {
      "id": "neurocrine-body",
      "description": "Neurocrine via Coupa - extract from body",
      "match": {
        "subject_contains": [
          "Neurocrine"
        ]
      },
      "action": "extract_body",
      "short_name": "Neurocrine"
    },
    {
      "id": "remittance-advice-attachment",
      "description": "Generic Remittance Advice with PDF - save attachment",
      "match": {
        "subject_contains": [
          "Remittance Advice"
        ]
      },
      "action": "save_attachment",
      "short_name": "extract_from_pdf",
      "notes": "Catch-all for remittance advice PDFs."
    }
  ]
}