{
  "version": "1.0.29",
  "updated": "2026-07-24",
  "rules": [
    {
      "id": "skip-overdue-invoices",
      "description": "Overdue-invoice/dunning notice - not a payment",
      "match": {
        "subject_contains": [
          "Overdue Invoices"
        ]
      },
      "action": "skip"
    },
    {
      "id": "skip-legal-notices",
      "description": "Legal/bankruptcy notices (Chapter 11 plan, reorganization) - not a remittance",
      "match": {
        "subject_contains": [
          "Chapter 11 Plan",
          "Plan of Reorganization"
        ]
      },
      "action": "skip"
    },
    {
      "id": "skip-marketing-newsletter",
      "description": "Marketing newsletter - not a remittance",
      "match": {
        "subject_contains": [
          "hiring paradox"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bill-marketing-skip",
      "description": "BILL.com marketing/survey emails (marketing@hello.bill.com, e.g. 'A penny for your thoughts') - not a remittance",
      "match": {
        "from_contains": [
          "marketing@hello.bill.com"
        ]
      },
      "action": "skip"
    },
    {
      "id": "ariba-skip",
      "description": "Ariba login-only notices (no invoice/amount in email, view behind login) - skip",
      "match": {
        "subject_contains": [
          "Notice of new Remittance Advice"
        ],
        "from_contains": [
          "AribaNetworkAdmin"
        ]
      },
      "action": "skip",
      "no_label": true
    },
    {
      "id": "bill-invoice-skip",
      "description": "BILL.com invoice received/created notifications - skip | advance payment notices ('sent you a payment arriving')",
      "match": {
        "subject_contains": [
          "received your invoice",
          "created a new bill",
          "sent you a payment arriving"
        ]
      },
      "action": "skip"
    },
    {
      "id": "gsk-statement-skip",
      "description": "GSK supplier statement - skip",
      "match": {
        "subject_contains": [
          "Supplier Statement"
        ]
      },
      "action": "skip"
    },
    {
      "id": "amgen-skip",
      "description": "Amgen invoice status notification - skip",
      "match": {
        "subject_contains": [
          "Amgen P2P",
          "invoices we have entered"
        ]
      },
      "action": "skip"
    },
    {
      "id": "takeda-rejection-skip",
      "description": "Takeda invoice rejection - skip",
      "match": {
        "subject_contains": [
          "cannot be processed",
          "will be resubmit"
        ]
      },
      "action": "skip"
    },
    {
      "id": "arhelpdesk-skip",
      "description": "Internal AR HelpDesk correspondence - skip (helpdesk sender or ARHelpDesk-tagged subject); dropped broad 'Payment Inquiry'/'FW: Re: Science Exchange' to avoid silently skipping a real remittance",
      "match": {
        "subject_contains": [
          "ARHelpDesk",
          "Science Exchange Payment Inquiry"
        ],
        "from_contains": [
          "arhelpdesk@scienceexchange.com"
        ]
      },
      "action": "skip"
    },
    {
      "id": "svb-notification",
      "description": "Actual SVB payment notifications (bank template) - save if invoices listed individually, skip ranges",
      "match": {
        "from_contains": [
          "svb.com",
          "Silicon Valley Bank"
        ],
        "snippet_contains": [
          "SVB Payment Notification"
        ]
      },
      "action": "save_attachment",
      "short_name": ""
    },
    {
      "id": "bms-flag",
      "description": "BMS mismatch/RITM - flag for review",
      "match": {
        "subject_contains": [
          "MISMATCH",
          "RITM",
          "URGENT!!"
        ]
      },
      "action": "flag"
    },
    {
      "id": "payment-advice-note",
      "description": "Generic SAP 'Payment Advice Note' remittance (GSK, AbbVie, and other shared-format senders) - payor comes from the PDF, not assumed",
      "match": {
        "subject_contains": [
          "Payment Advice Note",
          "GlaxoSmithKline"
        ]
      },
      "action": "save_attachment",
      "short_name": "extract_from_pdf",
      "notes": "Sender is forwarded via remittances@. Body identifies GSK or Haleon. Check currency."
    },
    {
      "id": "amgen-attachment",
      "description": "Amgen Remittance Advice - save PDF attachment",
      "match": {
        "snippet_contains": [
          "Amgen Remittance Advice",
          "Please find enclosed Amgen"
        ]
      },
      "action": "save_attachment",
      "short_name": "Amgen"
    },
    {
      "id": "bms-attachment",
      "description": "BMS remittance PDF - real BMS only (subject or bms.com sender), not the generic 'Payment Notification' phrase",
      "match": {
        "subject_contains": [
          "Bristol Myers Squibb",
          "Bristol-Myers",
          "BMS Payment"
        ],
        "from_contains": [
          "bms.com"
        ]
      },
      "action": "save_attachment",
      "short_name": "BMS"
    },
    {
      "id": "takeda-attachment",
      "description": "Takeda payment advice - save PDF attachment",
      "match": {
        "subject_contains": [
          "Takeda payment advice",
          "Takeda"
        ]
      },
      "action": "save_attachment",
      "short_name": "Takeda"
    },
    {
      "id": "incyte-attachment",
      "description": "Incyte remittance details - save PDF attachment",
      "match": {
        "subject_contains": [
          "Incyte Remittance",
          "Incyte"
        ]
      },
      "action": "save_attachment",
      "short_name": "Incyte"
    },
    {
      "id": "gilead-attachment",
      "description": "Gilead Sciences remittance - match on sender (subject is generic \"Remittance Advice\")",
      "match": {
        "subject_contains": [
          "Gilead"
        ],
        "from_contains": [
          "gilead.com"
        ]
      },
      "action": "save_attachment",
      "short_name": "Gilead Sciences"
    },
    {
      "id": "vertex-attachment",
      "description": "Vertex Pharmaceuticals remittance - save attachment",
      "match": {
        "subject_contains": [
          "Vertex Remittance",
          "Vertex Pharmaceuticals"
        ]
      },
      "action": "save_attachment",
      "short_name": "Vertex"
    },
    {
      "id": "abbvie-attachment",
      "description": "AbbVie remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "AbbVie"
        ]
      },
      "action": "save_attachment",
      "short_name": "AbbVie"
    },
    {
      "id": "terray-attachment",
      "description": "Terray Therapeutics - save PDF attachment",
      "match": {
        "subject_contains": [
          "Terray Therapeutics"
        ]
      },
      "action": "save_attachment",
      "short_name": "Terray Therapeutics"
    },
    {
      "id": "bill-payment-misc",
      "description": "Misc payment notifications (sent you a payment of $X; X paid you USD Y) - extract via BILL body extractor",
      "match": {
        "subject_contains": [
          "sent you a payment of",
          "paid you",
          "should have arrived"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "syngenta-sender",
      "description": "Syngenta remittance - matched by sender, save PDF attachment",
      "match": {
        "from_contains": [
          "syngenta.com"
        ]
      },
      "action": "save_attachment",
      "short_name": "Syngenta"
    },
    {
      "id": "regeneron-body",
      "description": "Regeneron 'Payment Remittance Advice' (subject 'Separate Remittance Advice') - data in body/HTML, extract & generate PDF",
      "match": {
        "snippet_contains": [
          "Regeneron Pharmaceuticals"
        ],
        "from_contains": [
          "regeneron.com"
        ],
        "subject_contains": [
          "Separate Remittance Advice"
        ]
      },
      "action": "extract_body",
      "short_name": "Regeneron"
    },
    {
      "id": "remittance-advice-attachment",
      "description": "Generic Remittance Advice with PDF - save attachment",
      "match": {
        "subject_contains": [
          "Remittance Advice",
          "Remittance Details",
          "Separate Remittance"
        ]
      },
      "action": "save_attachment",
      "short_name": "extract_from_pdf"
    },
    {
      "id": "ramp-delivered",
      "description": "Ramp payment delivered - extract from body",
      "match": {
        "subject_contains": [
          "Payment delivered for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject"
    },
    {
      "id": "ramp-advance-skip",
      "description": "Ramp advance payment notifications ('is on the way', 'sent payment for', '[Instant eligible]') \u2014 advance notice only, not a confirmed payment; the confirmed 'Payment received' email follows separately",
      "match": {
        "subject_contains": [
          "is on the way",
          "sent payment for",
          "get paid instantly",
          "get paid faster"
        ]
      },
      "action": "skip"
    },
    {
      "id": "ramp-batch",
      "description": "Ramp batch payment notification \u2014 'Payment initiated for N bills to Y from X'; payor and amount are in subject/body",
      "match": {
        "subject_contains": [
          "Payment initiated for"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "ramp-received",
      "description": "Ramp payment confirmed delivery (Payment received: RI-x from Y) \u2014 extract from body. Advance notices ('is on the way', 'sent payment for') are skipped separately.",
      "match": {
        "subject_contains": [
          "Payment received:"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject"
    },
    {
      "id": "brex-payment",
      "description": "Brex notification 'X sent you a payment of $Y' - payor from subject line, extract & generate PDF",
      "match": {
        "subject_contains": [
          "sent you a payment of"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "ariba-scheduled",
      "description": "Ariba scheduled payment - has invoice+amount+payor, extract from body",
      "match": {
        "subject_contains": [
          "new scheduled payment",
          "Notice of new scheduled payment"
        ],
        "from_contains": [
          "ansmtp.ariba.com"
        ]
      },
      "action": "extract_body",
      "short_name": ""
    },
    {
      "id": "bill-arriving",
      "description": "BILL.com payment arriving/deposited/delayed - extract from body (removed 'sent you a payment arriving' \u2014 advance notice only, duplicates the later 'will be deposited today' email)",
      "match": {
        "subject_contains": [
          "will be deposited today",
          "payment is delayed",
          "Your payment from",
          "Sent a payment of"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "mineraltree-body",
      "description": "MineralTree remittance notifications (Land Therapeutics, Senti Biosciences and other MineralTree-paying customers) - 'Account remittance detail for your payment'; payor, amount and invoices are all in the email body",
      "match": {
        "subject_contains": [
          "Account remittance detail for your payment"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "merck-body",
      "description": "Merck/MSD payment remittance - extract from body",
      "match": {
        "subject_contains": [
          "PAYMENT REMITTANCE DETAIL"
        ]
      },
      "action": "extract_body",
      "short_name": "Merck",
      "notes": "HTML-only body. Payor Name field has payor. Amount in USD format."
    },
    {
      "id": "coupa-body",
      "description": "Coupa payment notification - extract from body",
      "match": {
        "subject_contains": [
          "has sent you a",
          "Coupa"
        ],
        "from_contains": [
          "coupahost.com"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "insitro-attachment",
      "description": "Insitro ACH Remittance Advice \u2014 payor always Insitro; amount extracted from PDF attachment via body/REST path",
      "match": {
        "subject_contains": [
          "Insitro ACH Remittance Advice"
        ]
      },
      "action": "extract_body",
      "short_name": "Insitro"
    },
    {
      "id": "ariba-scheduled-skip",
      "description": "SAP Ariba/Business Network scheduled payment notice \u2014 advance notice only, payment not sent yet; skip",
      "match": {
        "subject_contains": [
          "Notice of new scheduled payment"
        ]
      },
      "action": "skip"
    },
    {
      "id": "zip-payment-arrived",
      "description": "Zip payment confirmation \u2014 'Payment should have arrived: X paid you $Y'; payor and amount in subject",
      "match": {
        "subject_contains": [
          "Payment should have arrived:"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "neurocrine-body",
      "description": "Neurocrine via Coupa - extract from body",
      "match": {
        "subject_contains": [
          "Neurocrine"
        ]
      },
      "action": "extract_body",
      "short_name": "Neurocrine"
    }
  ]
}