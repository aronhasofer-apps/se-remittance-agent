{
  "version": "1.0.4",
  "updated": "2026-06-23",
  "rules": [
    {
      "id": "ariba-skip",
      "description": "Ariba portal remittance notifications - skip, NO label",
      "match": {
        "subject_contains": [
          "Notice of new Remittance Advice",
          "AribaNetworkAdmin"
        ]
      },
      "action": "skip",
      "no_label": true
    },
    {
      "id": "bill-invoice-skip",
      "description": "BILL.com invoice received/created notifications - skip",
      "match": {
        "subject_contains": [
          "received your invoice",
          "created a new bill"
        ]
      },
      "action": "skip"
    },
    {
      "id": "gsk-statement-skip",
      "description": "GSK supplier statement (not a remittance) - skip",
      "match": {
        "subject_contains": [
          "Supplier Statement"
        ]
      },
      "action": "skip"
    },
    {
      "id": "amgen-skip",
      "description": "Amgen invoice status notification - skip",
      "match": {
        "subject_contains": [
          "Amgen P2P",
          "invoices we have entered"
        ]
      },
      "action": "skip"
    },
    {
      "id": "takeda-rejection-skip",
      "description": "Takeda invoice rejection - skip",
      "match": {
        "subject_contains": [
          "cannot be processed",
          "will be resubmit"
        ]
      },
      "action": "skip"
    },
    {
      "id": "arhelpdesk-skip",
      "description": "ARHelpDesk internal emails - skip",
      "match": {
        "subject_contains": [
          "ARHelpDesk",
          "FW: Re: Science Exchange"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bms-flag",
      "description": "BMS mismatch/RITM - flag for review",
      "match": {
        "subject_contains": [
          "MISMATCH",
          "RITM",
          "PO AND VENDOR NAME",
          "URGENT!!"
        ]
      },
      "action": "flag"
    },
    {
      "id": "gsk-attachment",
      "description": "GSK Payment Advice Note - save PDF attachment",
      "match": {
        "subject_contains": [
          "Payment Advice Note",
          "GlaxoSmithKline"
        ]
      },
      "action": "save_attachment",
      "short_name": "GSK",
      "notes": "Check currency - may be GBP."
    },
    {
      "id": "bms-attachment",
      "description": "Bristol Myers Squibb payment - save PDF attachment",
      "match": {
        "subject_contains": [
          "Bristol Myers Squibb",
          "Bristol-Myers",
          "BMS Payment",
          "Payment Notification"
        ]
      },
      "action": "save_attachment",
      "short_name": "BMS"
    },
    {
      "id": "incyte-attachment",
      "description": "Incyte remittance details - save PDF attachment",
      "match": {
        "subject_contains": [
          "Incyte Remittance"
        ]
      },
      "action": "save_attachment",
      "short_name": "Incyte",
      "notes": "Attachment contains remittance details. Sender: BATCHID_400@incyte.com"
    },
    {
      "id": "gilead-attachment",
      "description": "Gilead Sciences remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "Gilead"
        ]
      },
      "action": "save_attachment",
      "short_name": "Gilead Sciences"
    },
    {
      "id": "takeda-attachment",
      "description": "Takeda payment advice - save PDF attachment",
      "match": {
        "subject_contains": [
          "Takeda"
        ]
      },
      "action": "save_attachment",
      "short_name": "Takeda"
    },
    {
      "id": "vertex-attachment",
      "description": "Vertex Pharmaceuticals remittance - save attachment",
      "match": {
        "subject_contains": [
          "Vertex Remittance",
          "Vertex Pharmaceuticals"
        ]
      },
      "action": "save_attachment",
      "short_name": "Vertex"
    },
    {
      "id": "abbvie-attachment",
      "description": "AbbVie remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "AbbVie"
        ]
      },
      "action": "save_attachment",
      "short_name": "AbbVie"
    },
    {
      "id": "terray-attachment",
      "description": "Terray Therapeutics - save PDF attachment",
      "match": {
        "subject_contains": [
          "Terray Therapeutics"
        ]
      },
      "action": "save_attachment",
      "short_name": "Terray Therapeutics"
    },
    {
      "id": "remittance-advice-attachment",
      "description": "Generic Remittance Advice with PDF - save attachment",
      "match": {
        "subject_contains": [
          "Remittance Advice",
          "Remittance Details"
        ]
      },
      "action": "save_attachment",
      "short_name": "extract_from_pdf",
      "notes": "Catch-all for remittance advice PDFs including Incyte, Rainwater, Regeneron."
    },
    {
      "id": "ramp-delivered",
      "description": "Ramp payment delivered - extract from body",
      "match": {
        "subject_contains": [
          "Payment delivered for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject",
      "notes": "Payor after from in subject."
    },
    {
      "id": "ramp-received",
      "description": "Ramp payment received/on the way - extract from body",
      "match": {
        "subject_contains": [
          "Payment received:",
          "is on the way",
          "sent payment for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject",
      "notes": "Payor in subject. Invoice in subject or body."
    },
    {
      "id": "ariba-scheduled",
      "description": "Ariba scheduled payment - extract from body",
      "match": {
        "subject_contains": [
          "new scheduled payment",
          "Notice of new scheduled payment"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_body"
    },
    {
      "id": "bill-arriving",
      "description": "BILL.com payment arriving/deposited - extract from body",
      "match": {
        "subject_contains": [
          "sent you a payment arriving",
          "will be deposited today",
          "payment is delayed",
          "Your payment from",
          "Sent a payment of"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_body",
      "notes": "Subject has payor name. Body has amount and invoices. Format: [Company] initiated a payment of $X"
    },
    {
      "id": "merck-body",
      "description": "Merck payment remittance - extract from body",
      "match": {
        "subject_contains": [
          "PAYMENT REMITTANCE DETAIL"
        ]
      },
      "action": "extract_body",
      "short_name": "Merck"
    },
    {
      "id": "coupa-body",
      "description": "Coupa payment notification - extract from body",
      "match": {
        "subject_contains": [
          "has sent you a",
          "Coupa"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_body",
      "notes": "Recursion and other Coupa payors. Amount and payor in body."
    },
    {
      "id": "neurocrine-body",
      "description": "Neurocrine via Coupa - extract from body",
      "match": {
        "subject_contains": [
          "Neurocrine"
        ]
      },
      "action": "extract_body",
      "short_name": "Neurocrine"
    }
  ]
}