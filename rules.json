{
  "version": "1.0.12",
  "updated": "2026-06-24",
  "rules": [
    {
      "id": "skip-arriving-prenotice",
      "description": "BILL 'sent you a payment arriving' pre-notification - no invoice number, unusable; the 'will be deposited today' email carries the invoice",
      "match": {
        "subject_contains": [
          "sent you a payment arriving"
        ]
      },
      "action": "skip"
    },
    {
      "id": "skip-overdue-invoices",
      "description": "Overdue-invoice/dunning notice - not a payment",
      "match": {
        "subject_contains": [
          "Overdue Invoices"
        ]
      },
      "action": "skip"
    },
    {
      "id": "skip-legal-notices",
      "description": "Legal/bankruptcy notices (Chapter 11 plan, reorganization) - not a remittance",
      "match": {
        "subject_contains": [
          "Chapter 11 Plan",
          "Plan of Reorganization"
        ]
      },
      "action": "skip"
    },
    {
      "id": "skip-marketing-newsletter",
      "description": "Marketing newsletter - not a remittance",
      "match": {
        "subject_contains": [
          "hiring paradox"
        ]
      },
      "action": "skip"
    },
    {
      "id": "ariba-skip",
      "description": "Ariba portal remittance notifications - skip, NO label",
      "match": {
        "subject_contains": [
          "Notice of new Remittance Advice",
          "AribaNetworkAdmin",
          "Notice of new scheduled payment"
        ]
      },
      "action": "skip",
      "no_label": true
    },
    {
      "id": "bill-invoice-skip",
      "description": "BILL.com invoice received/created notifications - skip",
      "match": {
        "subject_contains": [
          "received your invoice",
          "created a new bill"
        ]
      },
      "action": "skip"
    },
    {
      "id": "gsk-statement-skip",
      "description": "GSK supplier statement - skip",
      "match": {
        "subject_contains": [
          "Supplier Statement"
        ]
      },
      "action": "skip"
    },
    {
      "id": "amgen-skip",
      "description": "Amgen invoice status notification - skip",
      "match": {
        "subject_contains": [
          "Amgen P2P",
          "invoices we have entered"
        ]
      },
      "action": "skip"
    },
    {
      "id": "takeda-rejection-skip",
      "description": "Takeda invoice rejection - skip",
      "match": {
        "subject_contains": [
          "cannot be processed",
          "will be resubmit"
        ]
      },
      "action": "skip"
    },
    {
      "id": "arhelpdesk-skip",
      "description": "ARHelpDesk internal emails - skip",
      "match": {
        "subject_contains": [
          "ARHelpDesk",
          "FW: Re: Science Exchange",
          "Science Exchange Payment Inquiry",
          "Payment Inquiry"
        ]
      },
      "action": "skip"
    },
    {
      "id": "svb-notification-skip",
      "description": "SVB wire payment notification - skip (invoice ranges unacceptable, no individual invoice numbers)",
      "match": {
        "subject_contains": [
          "Payment notification from"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bms-flag",
      "description": "BMS mismatch/RITM - flag for review",
      "match": {
        "subject_contains": [
          "MISMATCH",
          "RITM",
          "URGENT!!"
        ]
      },
      "action": "flag"
    },
    {
      "id": "gsk-attachment",
      "description": "GSK/Haleon Payment Advice Note - save PDF attachment",
      "match": {
        "subject_contains": [
          "Payment Advice Note",
          "GlaxoSmithKline"
        ]
      },
      "action": "save_attachment",
      "short_name": "GSK",
      "notes": "Sender is forwarded via remittances@. Body identifies GSK or Haleon. Check currency."
    },
    {
      "id": "amgen-attachment",
      "description": "Amgen Remittance Advice - save PDF attachment",
      "match": {
        "snippet_contains": [
          "Amgen Remittance Advice",
          "Please find enclosed Amgen"
        ]
      },
      "action": "save_attachment",
      "short_name": "Amgen"
    },
    {
      "id": "bms-attachment",
      "description": "Bristol Myers Squibb payment - save PDF attachment",
      "match": {
        "subject_contains": [
          "Bristol Myers Squibb",
          "Bristol-Myers",
          "BMS Payment",
          "Payment Notification"
        ]
      },
      "action": "save_attachment",
      "short_name": "BMS"
    },
    {
      "id": "takeda-attachment",
      "description": "Takeda payment advice - save PDF attachment",
      "match": {
        "subject_contains": [
          "Takeda payment advice",
          "Takeda"
        ]
      },
      "action": "save_attachment",
      "short_name": "Takeda"
    },
    {
      "id": "incyte-attachment",
      "description": "Incyte remittance details - save PDF attachment",
      "match": {
        "subject_contains": [
          "Incyte Remittance",
          "Incyte"
        ]
      },
      "action": "save_attachment",
      "short_name": "Incyte"
    },
    {
      "id": "gilead-attachment",
      "description": "Gilead Sciences remittance - match on sender (subject is generic \"Remittance Advice\")",
      "match": {
        "subject_contains": [
          "Gilead"
        ],
        "from_contains": [
          "gilead.com"
        ]
      },
      "action": "save_attachment",
      "short_name": "Gilead Sciences"
    },
    {
      "id": "vertex-attachment",
      "description": "Vertex Pharmaceuticals remittance - save attachment",
      "match": {
        "subject_contains": [
          "Vertex Remittance",
          "Vertex Pharmaceuticals"
        ]
      },
      "action": "save_attachment",
      "short_name": "Vertex"
    },
    {
      "id": "abbvie-attachment",
      "description": "AbbVie remittance - save PDF attachment",
      "match": {
        "subject_contains": [
          "AbbVie"
        ]
      },
      "action": "save_attachment",
      "short_name": "AbbVie"
    },
    {
      "id": "terray-attachment",
      "description": "Terray Therapeutics - save PDF attachment",
      "match": {
        "subject_contains": [
          "Terray Therapeutics"
        ]
      },
      "action": "save_attachment",
      "short_name": "Terray Therapeutics"
    },
    {
      "id": "gilead-sender",
      "description": "Gilead Sciences remittance - matched by SENDER (subject is the generic 'Remittance Advice'), save PDF attachment",
      "match": {
        "from_contains": [
          "gilead.com"
        ]
      },
      "action": "save_attachment",
      "short_name": "Gilead Sciences"
    },
    {
      "id": "bill-payment-misc",
      "description": "Misc payment notifications (sent you a payment of $X; X paid you USD Y) - extract via BILL body extractor",
      "match": {
        "subject_contains": [
          "sent you a payment of",
          "paid you",
          "should have arrived"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "remittance-advice-attachment",
      "description": "Generic Remittance Advice with PDF - save attachment",
      "match": {
        "subject_contains": [
          "Remittance Advice",
          "Remittance Details",
          "Separate Remittance"
        ]
      },
      "action": "save_attachment",
      "short_name": "extract_from_pdf"
    },
    {
      "id": "ramp-delivered",
      "description": "Ramp payment delivered - extract from body",
      "match": {
        "subject_contains": [
          "Payment delivered for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject"
    },
    {
      "id": "ramp-received",
      "description": "Ramp payment received/on the way - extract from body",
      "match": {
        "subject_contains": [
          "Payment received:",
          "is on the way",
          "sent payment for"
        ]
      },
      "action": "extract_body",
      "short_name": "extract_from_subject"
    },
    {
      "id": "ariba-scheduled",
      "description": "Ariba scheduled payment - extract from body",
      "match": {
        "subject_contains": [
          "new scheduled payment",
          "Notice of new scheduled payment"
        ]
      },
      "action": "skip"
    },
    {
      "id": "bill-arriving",
      "description": "BILL.com payment arriving/deposited/delayed - extract from body",
      "match": {
        "subject_contains": [
          "sent you a payment arriving",
          "will be deposited today",
          "payment is delayed",
          "Your payment from",
          "Sent a payment of"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "merck-body",
      "description": "Merck/MSD payment remittance - extract from body",
      "match": {
        "subject_contains": [
          "PAYMENT REMITTANCE DETAIL"
        ]
      },
      "action": "extract_body",
      "short_name": "Merck",
      "notes": "HTML-only body. Payor Name field has payor. Amount in USD format."
    },
    {
      "id": "coupa-body",
      "description": "Coupa payment notification - extract from body",
      "match": {
        "subject_contains": [
          "has sent you a",
          "Coupa"
        ],
        "from_contains": [
          "coupahost.com"
        ]
      },
      "action": "extract_body"
    },
    {
      "id": "neurocrine-body",
      "description": "Neurocrine via Coupa - extract from body",
      "match": {
        "subject_contains": [
          "Neurocrine"
        ]
      },
      "action": "extract_body",
      "short_name": "Neurocrine"
    }
  ]
}